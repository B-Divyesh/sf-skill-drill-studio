{
  "name": "skill-drill-studio",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test:unit": "vitest run src",
    "test:artifacts": "npm run build && node scripts/test-generated-artifacts.mjs",
    "test:claims": "playwright test --config=playwright.claims.config.ts",
    "test": "npm run test:unit && npm run test:artifacts && npm run test:claims",
    "test:e2e": "playwright test --config=playwright.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.58.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
